Putting It All Together
def run_pipeline(df, transformation_config, action_config, custom_transforms={}, custom_actions={}):
    try:
        transformed_df = apply_transformations(df, transformation_config, custom_transforms)
        result = execute_action(transformed_df, action_config, custom_actions)
        return result
    except Exception as e:
        import logging
        logging.exception("Pipeline execution failed")
        raise
