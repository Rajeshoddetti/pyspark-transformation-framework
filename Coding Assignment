. Setup the Transformation & Action Dictionaries
from pyspark.sql import functions as F

# --- TRANSFORMATIONS ---

TRANSFORMATIONS = {
    "select": lambda df, params: df.select(*params["columns"]),
    "filter": lambda df, params: df.filter(params["condition"]),
    "withColumn": lambda df, params: df.withColumn(params["name"], eval(params["expression"])),
    "drop": lambda df, params: df.drop(*params["columns"]),
    "alias": lambda df, params: df.alias(params["alias"]),
    "groupBy": lambda df, params: df.groupBy(*params["group_by"]).agg(*[getattr(F, agg["func"])(agg["col"]).alias(agg["alias"]) for agg in params["aggregations"]]),
    "join": lambda df, params: df.join(params["other_df"], on=params["on"], how=params.get("how", "inner")),
    "orderBy": lambda df, params: df.orderBy(*params["columns"]),
    "cache": lambda df, _: df.cache(),
    "repartition": lambda df, params: df.repartition(params["num_partitions"]),
    # add more as needed
}
Define Action Dictionary
ACTIONS = {
    "show": lambda df, params: df.show(params.get("n", 20), truncate=params.get("truncate", True)),
    "collect": lambda df, _: df.collect(),
    "write": lambda df, params: df.write.mode(params.get("mode", "overwrite")).format(params.get("format", "parquet")).save(params["path"]),
    "count": lambda df, _: df.count(),
    # add more actions like `write.jdbc`, `write.json`, etc.
}
Transformation Chain Executor
def apply_transformations(df, transformations, custom_funcs={}):
    for step in transformations:
        op = step["operation"]
        params = step.get("params", {})
        if op in TRANSFORMATIONS:
            df = TRANSFORMATIONS[op](df, params)
        elif op in custom_funcs:
            df = custom_funcs[op](df, params)
        else:
            raise ValueError(f"Unknown transformation operation: {op}")
    return df
 Action Executor
def execute_action(df, action_config, custom_actions={}):
    action = action_config["action"]
    params = action_config.get("params", {})
    if action in ACTIONS:
        return ACTIONS[action](df, params)
    elif action in custom_actions:
        return custom_actions[action](df, params)
    else:
        raise ValueError(f"Unknown action: {action}")
Custom Function Registration (Optional)
def transform_uppercase_column(df, params):
    col_name = params["column"]
    return df.withColumn(col_name, F.upper(F.col(col_name)))

CUSTOM_TRANSFORMS = {
    "uppercase_column": transform_uppercase_column
}
